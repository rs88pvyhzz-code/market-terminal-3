diff --git a/tests/browser_terminal3.py b/tests/browser_terminal3.py
new file mode 100644
index 0000000..b9bd27c
--- /dev/null
+++ b/tests/browser_terminal3.py
@@ -0,0 +1,31 @@
+"""Terminal 3: visible periods, semantic colours and closed-register headings."""
+import os,sys
+from pathlib import Path
+from playwright.sync_api import sync_playwright
+html=Path(sys.argv[1]).read_text()
+with sync_playwright() as p:
+    browser=p.chromium.launch(executable_path=os.environ.get('CHROMIUM_EXECUTABLE'),headless=True,args=['--no-sandbox'])
+    page=browser.new_page(viewport={'width':1366,'height':1024})
+    errors=[];page.on('pageerror',lambda e:errors.append(str(e)))
+    page.route('http://localhost:8765/**',lambda r:r.fulfill(body=html,content_type='text/html'))
+    page.goto('http://localhost:8765/',wait_until='domcontentloaded',timeout=120000)
+    page.locator('#tab-etfs').dispatch_event('click');page.wait_for_timeout(500)
+    for name in ['1D','1M','1Y','3Y','5Y']:
+        head=page.locator('.etf-table thead th').filter(has_text=__import__('re').compile('^'+name+'$'))
+        assert head.count()==1 and head.is_visible(),name
+    assert page.locator('#etf-risk-stats .rd-key-metric').count()>=3
+    for value in page.locator('#etf-risk-stats .rd-key-metric .v').all():
+        text=value.inner_text().replace('−','-').strip()
+        try:n=float(text.rstrip('%'))
+        except ValueError:continue
+        if n>0:assert 'rd-pos' in value.get_attribute('class')
+        if n<0:assert 'rd-neg' in value.get_attribute('class')
+    # Closed reference tables cannot float their headers over the chart.
+    page.locator('#etf-chart').scroll_into_view_if_needed();page.wait_for_timeout(200)
+    floating=page.locator('.table-reading-head').all_text_contents()
+    assert not any('US ticker' in h and 'Issuer fund' in h for h in floating),floating
+    page.screenshot(path='/tmp/compact-terminal3-etf-detail.png')
+    page.evaluate('scrollTo(0,0)');page.screenshot(path='/tmp/compact-terminal3-etf-list.png')
+    assert not errors,errors
+    browser.close()
+print('PASS Terminal 3 periods, return colours and closed-reference headers')
