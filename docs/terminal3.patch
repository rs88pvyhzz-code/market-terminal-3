@@ -0,0 +1,43 @@
+"""Regression coverage for migration recovery and Treasury date-form changes."""
+import datetime as dt
+import unittest
+from unittest.mock import patch,MagicMock
+from urllib.parse import parse_qs
+import us_treasury_market as treasury
+
+class TreasuryFormTests(unittest.TestCase):
+    def test_public_form_posts_date_and_session_token(self):
+        form=b'<form id="fromToDate"><input name="priceDate" value="2026-11-13" value="11/13/26"><input name="_csrf" value="test-token"></form>'
+        opener=MagicMock()
+        opener.open.return_value.__enter__.return_value.read.side_effect=[form,b'quote table']
+        day=dt.date(2026,11,13)
+        with patch.object(treasury.urllib.request,'build_opener',return_value=opener),patch.object(treasury,'parse_html',return_value=([{}],day)):
+            rows,published=treasury.fetch_dated(None,dt.date(2026,11,16))
+        posted=opener.open.call_args_list[1].args[0]
+        self.assertEqual(posted.get_method(),'POST')
+        self.assertEqual(parse_qs(posted.data.decode())['priceDate'],['2026-11-13'])
+        self.assertEqual(parse_qs(posted.data.decode())['_csrf'],['test-token'])
+        self.assertEqual(published,day)
+        self.assertEqual(rows[0]['source'],treasury.DETAIL_URL)
+
+    def test_wrong_response_date_is_rejected(self):
+        opener=MagicMock()
+        opener.open.return_value.__enter__.return_value.read.side_effect=[b'<form id="fromToDate"><input name="_csrf" value="test-token"></form>',b'table']
+        with patch.object(treasury.urllib.request,'build_opener',return_value=opener),patch.object(treasury,'parse_html',return_value=([{}],dt.date(2026,11,12))):
+            with self.assertRaisesRegex(ValueError,'differs'):
+                treasury.fetch_dated(dt.date(2026,11,13),dt.date(2026,11,16))
+
+    def test_case_sensitive_recovery_after_missing_new_site(self):
+        path=MagicMock();path.exists.return_value=False
+        expected={'asOf':'2026-11-13','bonds':[{'cusip':'912797VX2'}]}
+        calls=[]
+        def response(url):
+            calls.append(url)
+            if '/Market-terminal-2/' in url:return expected
+            raise OSError('404')
+        with patch.object(treasury,'public_json',side_effect=response):
+            saved=treasury.prior_file(path,treasury.PUBLIC_LATEST)
+        self.assertEqual(saved,expected)
+        self.assertIn('/Market-terminal-2/',calls[-1])
+
+if __name__=='__main__':unittest.main()
